<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="Autofill">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/widget_configure_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <!-- Display Style Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_display_style"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_widget_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_type_digital"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/widget_type_digital" />

        <RadioButton
            android:id="@+id/rb_type_gauge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_type_gauge" />

        <RadioButton
            android:id="@+id/rb_type_chart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_type_chart_option" />
    </RadioGroup>

    <!-- Analog Gauge Specific Configuration Fields -->
    <LinearLayout
        android:id="@+id/layout_gauge_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_range_and_redline"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_min_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Min"
                android:inputType="numberDecimal"
                android:text="0" />

            <EditText
                android:id="@+id/et_max_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Max"
                android:inputType="numberDecimal"
                android:text="8000" />

            <EditText
                android:id="@+id/et_redline_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Redline"
                android:inputType="numberDecimal"
                android:text="6000" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chart Time Window Configuration Fields -->
    <LinearLayout
        android:id="@+id/layout_chart_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_chart_timeframe"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_time_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/widget_select_pid"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

    <!-- Search Input Field -->
    <EditText
        android:id="@+id/et_search_pid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:hint="@string/widget_search_pid_hint"
        android:inputType="text"
        android:maxLines="1" />

    <ListView
        android:id="@+id/pid_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:divider="?android:attr/listDivider"
        android:dividerHeight="1dp" />

    <!-- Save Configuration Button -->
    <Button
        android:id="@+id/btn_save_widget_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:text="@string/widget_save_config"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

</LinearLayout>
